# ─── PostgreSQL ───────────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@localhost:5432/enterprise_lms

# ─── MongoDB ──────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/enterprise_lms

# ─── Redis ────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── MinIO ────────────────────────────────────────────────
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=enterprise-lms

# ─── Kafka ────────────────────────────────────────────────
KAFKA_BROKERS=localhost:9092

# ─── Qdrant ───────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# ─── ClickHouse ───────────────────────────────────────────
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# ─── Auth ─────────────────────────────────────────────────
JWT_SECRET=change_me_in_production
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── AI ───────────────────────────────────────────────────
OPENAI_API_KEY=
GEMINI_API_KEY=

# ─── Services (internal) ──────────────────────────────────
AUTH_SERVICE_URL=http://localhost:3001
LEARNING_SERVICE_URL=http://localhost:3002
AI_SERVICE_URL=http://localhost:3003
ANALYTICS_SERVICE_URL=http://localhost:3004
NOTIFICATION_SERVICE_URL=http://localhost:3005
GAME_SERVICE_URL=http://localhost:3006
MEDIA_SERVICE_URL=http://localhost:3007
REALTIME_GATEWAY_URL=http://localhost:3008

# ─── Web ──────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_WS_URL=ws://localhost:3008
